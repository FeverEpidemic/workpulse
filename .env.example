# WorkPulse environment template.
#
# Copy to `.env.local` for the web app and worker, then fill in the values from your
# own Supabase project. Never commit the filled-in file: `.env*` is git-ignored except
# this template. Local development uses the Supabase CLI stack (`pnpm db:start`), whose
# URL and keys are printed by `pnpm db:status`.

# --- Public web configuration (safe to expose to the browser) ---
NEXT_PUBLIC_SUPABASE_URL=
# New-style publishable key (`sb_publishable_...`), not the legacy anon key.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- Server-only configuration (never expose to the browser) ---
SUPABASE_URL=
# New-style secret key (`sb_secret_...`), not the legacy service-role JWT.
SUPABASE_SECRET_KEY=
# Trusted origin used only for Auth email redirects; do not derive it from Host.
WORKPULSE_SITE_URL=http://127.0.0.1:3000
# PostgreSQL connection string used by migrations and integration tests.
DATABASE_URL=

# --- Worker configuration ---
WORKPULSE_WORKER_ID=
# One of: debug, info, warn, error.
LOG_LEVEL=info
# Evidence screening is fail-closed. Use unavailable when no scanner is configured.
# fake-clean is allowed only with explicit NODE_ENV=development or test.
WORKPULSE_SCANNER_MODE=unavailable
# clamd must be reachable only over a trusted private network (no public TCP port).
WORKPULSE_CLAMD_HOST=127.0.0.1
WORKPULSE_CLAMD_PORT=13310
WORKPULSE_CLAMD_TIMEOUT_MS=15000
WORKPULSE_WORKER_POLL_INTERVAL_MS=5000

# --- AI processing (T13), worker process only ---
# Put real values in `.env.ai.local` (git-ignored), NOT in `.env.local`: `worker:run` and
# `worker:once` also read `.env.ai.local`, while the web server never needs the key.
# Default mode is unavailable (jobs fail with AI_UNAVAILABLE and manual paths keep working).
# `fake` is allowed only with explicit NODE_ENV=development or test. `openai-compatible`
# (alias `openai`) needs the key and the model, otherwise jobs fail closed with
# AI_CONFIG_INVALID. The base URL selects the processor (https, or http only for localhost).
# WORKPULSE_AI_MODE=openai-compatible
# WORKPULSE_OPENAI_BASE_URL=https://api.openai.com/v1
# WORKPULSE_OPENAI_API_KEY=
# WORKPULSE_AI_MODEL=gpt-6-luna
# chat_completions (default, widest support) or responses.
# WORKPULSE_AI_API=chat_completions
# json_schema (default, strict Structured Outputs) or json_object (JSON mode; schema in prompt).
# WORKPULSE_AI_STRUCTURED_OUTPUT=json_schema
