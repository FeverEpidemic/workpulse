{
  "name": "workpulse",
  "version": "0.1.0",
  "private": true,
  "description": "WorkPulse private career workspace (MVP v0.1)",
  "packageManager": "pnpm@11.19.0",
  "type": "module",
  "engines": {
    "node": ">=24.18.0 <25"
  },
  "scripts": {
    "dev": "next dev",
    "start": "next start",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --configLoader native",
    "test:e2e": "playwright test",
    "test:e2e:auth": "playwright test --config playwright.auth.config.ts tests/e2e/auth-profile.spec.ts",
    "test:e2e:ui": "playwright test --config playwright.ui.config.ts tests/e2e/app-frame.spec.ts",
    "test:e2e:activity": "playwright test --config playwright.activity.config.ts tests/e2e/activity-ui.spec.ts",
    "test:e2e:projects": "playwright test --config playwright.projects.config.ts tests/e2e/projects-ui.spec.ts",
    "test:e2e:dashboard": "playwright test --config playwright.dashboard.config.ts tests/e2e/dashboard-timeline.spec.ts",
    "test:e2e:achievements": "playwright test --config playwright.achievements.config.ts tests/e2e/achievements-ui.spec.ts",
    "test:e2e:evidence": "playwright test --config playwright.evidence.config.ts",
    "test:e2e:m2": "playwright test --config playwright.m2.config.ts tests/e2e/m2-manual-journey.spec.ts",
    "test:e2e:ai-review": "playwright test --config playwright.ai-review.config.ts tests/e2e/ai-review.spec.ts",
    "test:e2e:ai":"playwright test --config playwright.ai.config.ts tests/e2e/ai-consent.spec.ts",
    "test:integration:activity": "vitest run --config vitest.integration.config.ts --configLoader native tests/integration/activity-persistence.test.ts",
    "test:integration:projects": "vitest run --config vitest.integration.config.ts --configLoader native tests/integration/project-context.test.ts",
    "test:integration:achievements": "vitest run --config vitest.integration.config.ts --configLoader native tests/integration/achievement-lifecycle.test.ts",
    "test:integration:dashboard": "vitest run --config vitest.integration.config.ts --configLoader native tests/integration/dashboard-timeline.test.ts",
    "test:integration:m2": "vitest run --config vitest.integration.config.ts --configLoader native tests/integration/m2-cross-domain.test.ts",
    "test:integration:ai": "vitest run --config vitest.integration.config.ts --configLoader native tests/integration/ai-jobs.test.ts",
    "test:integration:ai-review": "vitest run --config vitest.integration.config.ts --configLoader native tests/integration/ai-review.test.ts",
    "test:ai:live": "vitest run --config vitest.live.config.ts --configLoader native tests/live/openai-smoke.test.ts",
    "test:integration:storage": "vitest run --config vitest.integration.config.ts --configLoader native tests/integration/private-storage.test.ts",
    "test:integration:evidence": "vitest run --config vitest.integration.config.ts --configLoader native tests/integration/evidence-backend.test.ts tests/integration/evidence-scanner-real.test.ts tests/integration/evidence-pipeline.test.ts",
    "build": "next build",
    "worker:check": "node workers/check.ts",
    "worker:run": "node --env-file-if-exists=.env.local --env-file-if-exists=.env.ai.local workers/run.ts",
    "worker:once": "node --env-file-if-exists=.env.local --env-file-if-exists=.env.ai.local workers/run.ts --once",
    "db:start": "supabase start",
    "db:status": "supabase status",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:test": "supabase test db",
    "db:lint": "supabase db lint --level error",
    "db:types": "supabase gen types typescript --local --schema public"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.116.0",
    "lucide-react": "1.46.0",
    "next": "16.3.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.13.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.1",
    "eslint-config-next": "16.3.5",
    "supabase": "2.117.0",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vitest": "5.0.0"
  }
}
